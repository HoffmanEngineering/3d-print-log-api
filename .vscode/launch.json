{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PrintLogApi/bin/Debug/net10.0/PrintLogApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PrintLogApi",
            "stopAtEntry": false,
            // Bound to 0.0.0.0 rather than localhost so the API is reachable from other
            // devices on the LAN (testing the UI on a phone). launch.json's env wins over
            // the profile's applicationUrl, so `dotnet run` and Visual Studio stay on
            // localhost - only an F5 from VS Code opens the ports up.
            "env": {
                "ASPNETCORE_URLS": "https://0.0.0.0:5001;http://0.0.0.0:5000"
            },
            "launchSettingsFilePath": "${workspaceFolder}/PrintLogApi/Properties/launchSettings.json",
            "launchSettingsProfile": "PrintLogApi"
        },
        {
            "name": "Launch (Staging)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PrintLogApi/bin/Debug/net10.0/PrintLogApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PrintLogApi",
            "stopAtEntry": false,
            "launchSettingsFilePath": "${workspaceFolder}/PrintLogApi/Properties/launchSettings.json",
            "launchSettingsProfile": "PrintLogApi - Staging"
        },
        {
            "name": "Launch (E2E Testing)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PrintLogApi/bin/Debug/net10.0/PrintLogApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PrintLogApi",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_URLS": "https://0.0.0.0:5001;http://0.0.0.0:5000"
            },
            "launchSettingsFilePath": "${workspaceFolder}/PrintLogApi/Properties/launchSettings.json",
            "launchSettingsProfile": "E2E Testing"
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}

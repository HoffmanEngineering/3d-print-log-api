<Project>

  <!-- Repo-wide build settings. Imported automatically by every project under this directory,
       including any project added later - which is the point. Settings that have to hold for
       the whole repo to stay correct belong here, not copied into each .csproj where a new
       project silently starts without them. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The nullable migration (#46) is complete. Every source file outside Migrations/ already
         carried an explicit "#nullable enable" from #42-#44, so this flip turns the annotation
         context on for the generated migrations too and makes the per-file headers redundant
         rather than changing how the app itself compiles.

         Verified at the flip: zero CS86xx warnings, and
         "dotnet ef migrations has-pending-model-changes" green, which is what proves EF Core's
         schema inference did not move. -->
    <Nullable>enable</Nullable>

    <!-- The ratchet. Without it the migration decays: a new nullable warning is one line in a
         build log nobody reads, and the annotations stop meaning anything within a release or two.

         This is the setting that most needs to be repo-wide rather than per-project. A new project
         that starts without it does not fail - it just quietly opts out of the invariant, and
         nothing reports that it did. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>

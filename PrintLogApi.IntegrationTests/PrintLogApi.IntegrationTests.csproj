<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable and WarningsAsErrors live in Directory.Build.props at the repo
       root. Package versions live in Directory.Packages.props.

       On the inherited nullable settings: the precision bar here is deliberately lower than
       PrintLogApi's: a "!" in test setup or an assertion is fine where the test has just created
       the row it is reading back. What is NOT fine is a nullable warning surviving, because the
       suite is where a wrong annotation in the app first shows up as a real failure - which is why
       this project takes the same WarningsAsErrors ratchet rather than opting out of it. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- xunit.v3's own props already set this, but it is stated here because it is the single fact
         that explains everything else about this project under Microsoft.Testing.Platform: the test
         assembly IS the runner. `dotnet run` on it executes the suite, `dotnet test` launches that
         same executable, and there is no external VSTest host to attach a datacollector to. -->
    <OutputType>Exe</OutputType>

    <!-- Makes `dotnet test` drive the executable through MTP's protocol instead of handing the
         assembly to VSTest. The repo-root dotnet.config selects the same runner for the whole
         repo; this property is the per-project half, and both are set so that neither a stray
         `dotnet test PrintLogApi.IntegrationTests.csproj` from another directory nor a future
         second test project can silently fall back to VSTest. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="xunit.v3" />
    <!-- MTP's code-coverage extension, the replacement for the coverlet.collector datacollector.
         Deliberately without PrivateAssets=all: it registers the coverage command-line options on
         the test host at runtime, so its runtime assets have to flow into the output. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintLogApi\PrintLogApi.csproj" />
  </ItemGroup>

  <!-- The golden cost corpus, shared byte-for-byte with the UI repo's copy so a divergence
       between PrintCostCalculator and print.service.ts fails both suites. -->
  <ItemGroup>
    <None Include="..\tests-fixtures\cost-fixtures.json" CopyToOutputDirectory="PreserveNewest" Link="tests-fixtures\cost-fixtures.json" />
  </ItemGroup>

</Project>

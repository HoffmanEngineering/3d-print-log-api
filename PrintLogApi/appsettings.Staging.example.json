{
  "Auth0": {
    "Domain": "YOUR_AUTH0_STAGING_TENANT.auth0.com",
    "ApiIdentifier": "https://YOUR_AUTH0_STAGING_API_IDENTIFIER"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "ConnectionString": {
    "PrintLogDb": "Server=YOUR_STAGING_SERVER;Database=PrintLogDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Email": {
    "_comment": "Use DryRun or an AllowListUserIds entry on staging; never send to real users from here. Keys: openssl rand -base64 32. See docs/email-runbook.md.",
    "Enabled": false,
    "DryRun": false,
    "AllowListUserIds": [],
    "PostalAddress": "PO Box 0, Example City, ST 00000, USA",
    "WebBaseUrl": "https://YOUR_STAGING_UI_HOST",
    "ApiBaseUrl": "https://YOUR_STAGING_API_HOST",
    "UnsubscribeSigningKeys": [ "REPLACE_WITH_BASE64_32_BYTES" ],
    "SuppressionPeppers": [ "REPLACE_WITH_BASE64_32_BYTES" ],
    "Ses": {
      "Region": "us-east-2",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "ConfigurationSet": "",
      "EventsTopicArn": ""
    },
    "Campaigns": {
      "onboarding": { "Enabled": false },
      "printer-silent": { "Enabled": false },
      "monthly-recap": { "Enabled": false }
    }
  }
}

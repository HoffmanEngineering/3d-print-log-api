@* A bulletproof-ish button: a table cell carries the color so clients that ignore padding on
   links (Outlook) still show a solid block, and the link stays clickable everywhere. In designed
   dark mode it flips to the light accent so it still stands out. *@
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
    <tr>
        <td class="em-btn" bgcolor="#3f51b5" style="border-radius:6px;background-color:#3f51b5;">
            <a href="@Href" class="em-btn-link" style="display:inline-block;padding:12px 24px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:20px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:6px;">@Text</a>
        </td>
    </tr>
</table>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    [Parameter, EditorRequired] public string Text { get; set; } = "";
}

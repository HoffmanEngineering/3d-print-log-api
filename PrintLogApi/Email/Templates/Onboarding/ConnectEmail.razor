@* The three integrations as small cards, each with its setup guide and the one-line effort it
   takes, so the choice reads at a glance. *@
<EmailLayout Title="@OnboardingTemplates.Subject(OnboardingTemplates.Connect)" Kicker="Getting started" Headline="@OnboardingTemplates.Subject(OnboardingTemplates.Connect)" Preheader="Connect OctoPrint, Klipper or your slicer and skip the typing." Footer="Footer">
    <p style="margin:0 0 16px 0;">@EmailFormat.Greeting(Model.Name)</p>
    <p style="margin:0 0 16px 0;">Typing in every print gets old fast. Connect the tool you already use and new prints show up on their own:</p>
    @foreach (var (name, url, how) in Integrations)
    {
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 10px 0;">
            <tr>
                <td class="em-panel" style="padding:12px 16px;border:1px solid #e0e0e0;border-radius:6px;">
                    <a href="@url" class="em-link" style="font-size:16px;line-height:22px;color:#3f51b5;font-weight:bold;">@name</a>
                    <div class="em-muted" style="font-size:14px;line-height:20px;color:#424242;">@how</div>
                </td>
            </tr>
        </table>
    }
    <p style="margin:6px 0 0 0;">Each one takes about five minutes.</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public OnboardingModel Model { get; set; } = default!;

    [Parameter, EditorRequired] public EmailFooterModel Footer { get; set; } = default!;

    private IEnumerable<(string Name, string Url, string How)> Integrations =>
    [
        ("OctoPrint", Model.OctoPrintUrl, "Install the webhook plugin."),
        ("Klipper (Moonraker)", Model.KlipperUrl, "Add one block to your config."),
        ("Your slicer", Model.SlicerUrl, "Upload straight from PrusaSlicer, OrcaSlicer or SuperSlicer."),
    ];
}

<EmailLayout Title="@OnboardingTemplates.Subject(OnboardingTemplates.NextSteps)" Kicker="Getting started" Headline="@OnboardingTemplates.Subject(OnboardingTemplates.NextSteps)" Preheader="@($"{EmailFormat.Count(Model.PrintCount, "print", "prints")} logged so far.")" Footer="Footer">
    <p style="margin:0 0 16px 0;">@EmailFormat.Greeting(Model.Name)</p>
    <p style="margin:0 0 16px 0;">Here's where you are so far:</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px 0;">
        <tr>
            <td style="padding:12px;background-color:#e8eaf6;border-radius:6px 0 0 6px;text-align:center;"><div style="font-size:22px;font-weight:bold;color:#283593;">@Model.PrintCount</div><div style="font-size:13px;color:#424242;">@(Model.PrintCount == 1 ? "print" : "prints")</div></td>
            <td style="padding:12px;background-color:#e8eaf6;text-align:center;"><div style="font-size:22px;font-weight:bold;color:#283593;">@EmailFormat.Hours(Model.PrintHours)</div><div style="font-size:13px;color:#424242;">print time</div></td>
            <td style="padding:12px;background-color:#e8eaf6;border-radius:0 6px 6px 0;text-align:center;"><div style="font-size:22px;font-weight:bold;color:#283593;">@EmailFormat.Weight(Model.FilamentGrams)</div><div style="font-size:13px;color:#424242;">filament</div></td>
        </tr>
    </table>
    <p style="margin:0 0 16px 0;">You hold <strong>@Model.GettingStartedHeld of @Model.GettingStartedTotal</strong> Getting started badges.</p>
    <p style="margin:0;"><strong>Next:</strong> @Model.HintText</p>
    <EmailButton Href="@Model.CtaUrl" Text="@Model.CtaLabel" />
</EmailLayout>

@code {
    [Parameter, EditorRequired] public OnboardingModel Model { get; set; } = default!;

    [Parameter, EditorRequired] public EmailFooterModel Footer { get; set; } = default!;
}

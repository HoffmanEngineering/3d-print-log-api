<EmailLayout Title="@MonthlyRecapTemplates.Subject(Model)" Kicker="Monthly recap" Headline="@MonthlyRecapTemplates.Headline(Model)" Preheader="@MonthlyRecapTemplates.Intro(Model)" Footer="Footer">
    <p style="margin:0 0 16px 0;">@EmailFormat.Greeting(Model.Name)</p>
    <p style="margin:0 0 16px 0;">@MonthlyRecapTemplates.Intro(Model)</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px 0;border:1px solid #e0e0e0;border-radius:6px;">
        @foreach (var (value, label, change) in MonthlyRecapTemplates.Stats(Model))
        {
            <tr>
                <td style="padding:10px 16px;border-bottom:1px solid #f0f0f0;">
                    <span style="font-size:20px;font-weight:bold;color:#212121;">@value</span>
                    <span style="color:#424242;">@label</span>
                    @if (change is not null)
                    {
                        <div style="font-size:13px;color:#616161;">@change</div>
                    }
                </td>
            </tr>
        }
    </table>
    @if (MonthlyRecapTemplates.Highlights(Model) is { Count: > 0 } highlights)
    {
        <p style="margin:0 0 16px 0;">
            @foreach (var (label, value) in highlights)
            {
                <span style="color:#616161;">@label:</span> <strong>@value</strong><br />
            }
        </p>
    }
    @if (Model.Badges.Count > 0)
    {
        <p style="margin:0 0 4px 0;font-weight:bold;">Badges earned in @Model.MonthName</p>
        <ul style="margin:0 0 16px 0;padding-left:20px;">
            @foreach (var badge in Model.Badges)
            {
                <li>@badge</li>
            }
        </ul>
    }
    <EmailButton Href="@Model.StatsUrl" Text="@MonthlyRecapTemplates.CtaLabel" />
    @if (Model.Tip is { } tip)
    {
        <p style="margin:16px 0 0 0;font-size:14px;color:#424242;"><strong>Tip:</strong> @tip.Text <a href="@tip.Url" style="color:#3f51b5;">@tip.Label</a></p>
    }
</EmailLayout>

@code {
    [Parameter, EditorRequired] public MonthlyRecapModel Model { get; set; } = default!;

    [Parameter, EditorRequired] public EmailFooterModel Footer { get; set; } = default!;
}

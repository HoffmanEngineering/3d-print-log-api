@* One card per quiet printer, edged in amber (attention, not alarm) with a "Quiet N days" pill,
   the integration it reported through, a link to that integration's troubleshooting guide, and
   a quieter way out for a printer that's been retired. No supporter line: this is a help email. *@
<EmailLayout Title="@PrinterSilentTemplates.Subject(Model)" Kicker="Printer check-in" Headline="@PrinterSilentTemplates.Subject(Model)" Preheader="@Preheader" Footer="Footer">
    <p style="margin:0 0 16px 0;">@EmailFormat.Greeting(Model.Name)</p>
    <p style="margin:0 0 20px 0;">@PrinterSilentTemplates.Intro(Model)</p>
    @foreach (var p in Model.Printers)
    {
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px 0;">
            <tr>
                <td width="5" bgcolor="#ffb300" style="width:5px;background-color:#ffb300;border-radius:6px 0 0 6px;font-size:0;line-height:0;">&nbsp;</td>
                <td class="em-panel" style="padding:16px;border:1px solid #e0e0e0;border-left:0;border-radius:0 6px 6px 0;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tr>
                            <td valign="top">
                                <div style="font-size:17px;line-height:22px;font-weight:bold;">@p.Name</div>
                                @if (p.MakeModel is not null)
                                {
                                    <div class="em-muted" style="font-size:13px;line-height:18px;color:#616161;">@p.MakeModel</div>
                                }
                            </td>
                            <td valign="top" align="right" style="padding:0 0 0 12px;white-space:nowrap;">
                                <span style="display:inline-block;padding:3px 10px;background-color:#fff8e1;border-radius:10px;font-size:12px;line-height:16px;font-weight:bold;color:#8d6e00;">@PrinterSilentTemplates.QuietLabel(p.QuietDays)</span>
                            </td>
                        </tr>
                    </table>
                    <div class="em-muted" style="margin:10px 0;font-size:14px;line-height:20px;color:#424242;">Last heard from via <strong>@p.SourceLabel</strong> on <strong>@p.LastHeard</strong></div>
                    <div style="margin:0 0 6px 0;font-size:15px;line-height:20px;"><a href="@p.TroubleshootUrl" class="em-link" style="color:#3f51b5;font-weight:bold;">@p.TroubleshootLabel &rarr;</a></div>
                    <div class="em-muted" style="font-size:13px;line-height:18px;color:#616161;">Not using this printer anymore? <a href="@p.PrinterUrl" class="em-link" style="color:#5c6bc0;">Mark it inactive</a></div>
                </td>
            </tr>
        </table>
    }
    @if (Model.ApiKeyLastUsed is { } used)
    {
        <p class="em-muted" style="margin:0;font-size:14px;line-height:20px;color:#424242;">@PrinterSilentTemplates.ApiKeyLine(used)</p>
    }
</EmailLayout>

@code {
    [Parameter, EditorRequired] public PrinterSilentModel Model { get; set; } = default!;

    [Parameter, EditorRequired] public EmailFooterModel Footer { get; set; } = default!;

    private string Preheader => Model.Printers.Count == 1
        ? $"Last heard from on {Model.Printers[0].LastHeard}."
        : "A few of your printers have gone quiet.";
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable and WarningsAsErrors live in Directory.Build.props at the repo
       root. Package versions live in Directory.Packages.props. -->

  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>bfaad655-ddfb-44ba-954d-9a3c77613d90</UserSecretsId>
    <DockerfileRunEnvironmentFiles>3dprintlog.env</DockerfileRunEnvironmentFiles>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS8632 ("?" outside a nullable annotations context) is gone from this list: the context is
         now on project-wide, so the diagnostic can no longer fire and suppressing it would only
         hide a future "#nullable disable". -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

